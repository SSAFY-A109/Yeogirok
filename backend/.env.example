# 복사해서 .env 로 쓰거나 IDE 실행 설정의 환경 변수로 넣는다. .env 는 커밋하지 않는다.

# 서비스 JWT 서명 키. Base64, 디코드했을 때 32바이트 이상.
# 생성: openssl rand -base64 48
JWT_SECRET=

# Google Cloud Console > 사용자 인증 정보 > "웹 애플리케이션" 유형 OAuth 클라이언트 ID.
# 앱의 GoogleSignin.configure({ webClientId }) 와 같은 값이어야 ID 토큰 aud 가 맞는다.
GOOGLE_WEB_CLIENT_ID=

# 위 웹 클라이언트의 클라이언트 보안 비밀번호(secret). 구글 회원 탈퇴 때 앱이 보낸 serverAuthCode 를
# 토큰으로 바꿔 연결을 해제할 때만 쓴다(API-009). 서버 밖으로 내보내지 않는다. 비워 두면 구글 회원은 탈퇴할 수 없다.
GOOGLE_WEB_CLIENT_SECRET=

# 카카오 디벨로퍼스 > 앱 설정 > 앱 > 플랫폼 키 > 네이티브 앱 키. 네이티브 SDK 로 받은 ID 토큰의 aud 값.
# 처음 한 번 실제 토큰의 aud 를 확인해서 맞는 키를 넣는다(docs/05-social-login-setup.md §3-4).
KAKAO_APP_KEY=

# 카카오 디벨로퍼스 > 앱 설정 > 앱 > 어드민 키. 탈퇴 시 서버가 카카오 연결을 끊을 때 쓴다(API-009).
# 서버 밖으로 내보내지 않는다. 비워 두면 연결 해제를 하지 않고 재시도 대상으로만 남긴다.
KAKAO_ADMIN_KEY=

# DB (기본값은 application-local.yaml 과 같다)
DB_URL=jdbc:postgresql://localhost:5432/yeogirok
DB_USERNAME=yeogirok
DB_PASSWORD=yeogirok

# Redis (기본값은 application-local.yaml 과 같다. 로컬은 비밀번호 없음)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 멱등키 보관 기간과 처리 중 표시 수명 (기본값은 application-local.yaml 과 같다)
IDEMPOTENCY_RETENTION=24h
IDEMPOTENCY_PROCESSING_TIMEOUT=30s

# 현재 위치 증거 기준 (prod 는 필수. local 은 application-local.yaml 의 제안값을 쓴다)
# LOCATION_EVIDENCE_MAX_AGE=2m
# LOCATION_EVIDENCE_MAX_FUTURE_SKEW=30s
# LOCATION_POLICY_VERSION=location-v1

# 카카오 로컬 API REST 키 (선택. 없으면 발자취 주소·위치명이 null). 값은 여기에 커밋하지 않는다.
KAKAO_REST_API_KEY=
