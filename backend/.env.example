# 복사해서 .env 로 쓰거나 IDE 실행 설정의 환경 변수로 넣는다. .env 는 커밋하지 않는다.

# DB (기본값은 application-local.yaml 과 같다)
DB_URL=jdbc:postgresql://localhost:5432/yeogirok
DB_USERNAME=yeogirok
DB_PASSWORD=yeogirok

# Redis (기본값은 application-local.yaml 과 같다. 로컬은 비밀번호 없음)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 멱등키 보관 기간과 처리 중 표시 수명 (기본값은 application-local.yaml 과 같다)
IDEMPOTENCY_RETENTION=24h
IDEMPOTENCY_PROCESSING_TIMEOUT=30s

# 현재 위치 증거 기준 (prod 는 필수. local 은 application-local.yaml 의 제안값을 쓴다)
# LOCATION_EVIDENCE_MAX_AGE=2m
# LOCATION_EVIDENCE_MAX_FUTURE_SKEW=30s
# LOCATION_POLICY_VERSION=location-v1

# 카카오 로컬 API REST 키 (선택. 없으면 발자취 주소·위치명이 null). 값은 여기에 커밋하지 않는다.
KAKAO_REST_API_KEY=
