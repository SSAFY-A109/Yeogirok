# 서버에서 이 파일을 같은 폴더의 .env 로 복사해 값을 채운다.
#   cp .env.example .env && chmod 600 .env
# .env 는 절대 커밋하지 않는다 (공개 저장소). 주석은 항상 줄 맨 앞에 쓴다.

# --- DB ---
DB_NAME=yeogirok
DB_USERNAME=yeogirok
# 긴 무작위 값으로 바꾼다. 만드는 법: openssl rand -base64 24
DB_PASSWORD=change-me

# --- S3 파일 저장소 (여기록 S3 파일 저장소 구성 가이드 참고) ---
# 리전과 버킷 이름은 비밀 값이 아니다. 접근 키는 서버 전용 IAM 사용자(yeogirok-server-prod)의 키를 넣는다.
AWS_REGION=ap-northeast-2
# 사진과 영수증은 버킷을 나눈다 (영수증은 결제 정보라 보관·공개 설정을 따로 가져간다).
S3_PHOTO_BUCKET=yeogirok-a109-photos-prod
S3_RECEIPT_BUCKET=yeogirok-a109-receipts-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 이후 필요해지면 추가 (값은 노션에 적지 말고 이 파일에만) ---
# JWT_SECRET=
# KAKAO_REST_API_KEY=
# TOUR_API_KEY=
# GMS_KEY=
