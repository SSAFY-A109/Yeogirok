# 서버에서 이 파일을 같은 폴더의 .env 로 복사해 값을 채운다.
#   cp .env.example .env && chmod 600 .env
# .env 는 절대 커밋하지 않는다 (공개 저장소). 주석은 항상 줄 맨 앞에 쓴다.

# --- DB ---
DB_NAME=yeogirok
DB_USERNAME=yeogirok
# 긴 무작위 값으로 바꾼다. 만드는 법: openssl rand -base64 24
DB_PASSWORD=change-me

# --- 이후 필요해지면 추가 (값은 노션에 적지 말고 이 파일에만) ---
# JWT_SECRET=
# KAKAO_REST_API_KEY=
# TOUR_API_KEY=
# GMS_KEY=
