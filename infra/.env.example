# 서버에서 이 파일을 같은 폴더의 .env 로 복사해 값을 채운다.
#   cp .env.example .env && chmod 600 .env
# .env 는 절대 커밋하지 않는다 (공개 저장소). 주석은 항상 줄 맨 앞에 쓴다.

# --- DB ---
DB_NAME=yeogirok
DB_USERNAME=yeogirok
# 긴 무작위 값으로 바꾼다. 만드는 법: openssl rand -hex 24
# base64 는 / + 같은 기호가 섞여 AI 서버가 쓰는 DB 주소(postgresql://계정:비밀번호@db...)가 깨질 수 있으므로 hex 를 쓴다.
DB_PASSWORD=change-me

# --- Redis ---
# DB 비밀번호와 같은 방법으로 다른 값을 만든다: openssl rand -hex 24
# 비워 두면 compose 가 Redis 를 띄우지 않고 멈춘다.
REDIS_PASSWORD=change-me

# --- S3 파일 저장소 (여기록 S3 파일 저장소 구성 가이드 참고) ---
# 리전과 버킷 이름은 비밀 값이 아니다. 접근 키는 서버 전용 IAM 사용자(yeogirok-server-prod)의 키를 넣는다.
AWS_REGION=ap-northeast-2
# 사진과 영수증은 버킷을 나눈다 (영수증은 결제 정보라 보관·공개 설정을 따로 가져간다).
S3_PHOTO_BUCKET=yeogirok-a109-photos-prod
S3_RECEIPT_BUCKET=yeogirok-a109-receipts-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 로그인 (백엔드 backend/docs/05-social-login-setup.md 참고) ---
# 셋 중 하나라도 비어 있으면 백엔드가 뜨지 않는다.
# JWT 서명 키. 서버에서만 만든다: openssl rand -base64 48
# 백엔드가 Base64로 읽기 때문에 다른 비밀번호와 달리 hex 가 아니라 base64 로 만든다 (디코드해서 32바이트보다 짧으면 뜨지 않는다).
JWT_SECRET=
# 구글 "웹" 클라이언트 ID와 카카오 "네이티브 앱 키". 앱(프론트)과 같은 값이다.
# 아직 키가 없으면 임시 문자열을 넣는다. 백엔드는 뜨고 그 제공자 로그인만 실패한다.
GOOGLE_WEB_CLIENT_ID=
KAKAO_APP_KEY=
# 선택: 비어 있어도 백엔드는 뜬다. 탈퇴 시 연결 해제(구글 secret, 카카오 어드민 키)와 주소 표시(카카오 REST 키)에 쓴다.
# 비밀 값이다. 채팅·노션·Git 에 올리지 말고 서버에서 직접 입력한다(가이드 9단계).
GOOGLE_WEB_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_REST_API_KEY=
# 채팅 푸시(FCM) 서비스 계정 키 JSON 을 Base64 한 줄로 넣는다. 비밀 값, 커밋 금지. 비어 있으면 푸시만 보내지 않는다.
# 만드는 법: base64 -w0 서비스계정.json   (또는 openssl base64 -A -in 서비스계정.json)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- 여행방 초대 (백엔드 backend/.env.example 참고) ---
# 초대 토큰 암호화 키(AES-SIV). Base64, 디코드했을 때 64바이트. 서버에서만 만든다: openssl rand 64 | base64 -w0
# (openssl rand 에는 -A 옵션이 없어 "openssl rand -base64 -A 64" 는 실패하고 빈 값이 들어간다)
# 한 번 만든 뒤에는 바꾸지 않는다. 바꾸면 이미 만든 초대 토큰을 모두 다시 암호화해야 한다.
ROOM_INVITE_TOKEN_KEY=

# --- 이후 필요해지면 추가 (값은 노션에 적지 말고 이 파일에만) ---
# TOUR_API_KEY=
# GMS_KEY=
