{
  "name": "yeogirok-fe",
  "version": "1.0.0",
  "private": false,
  "packageManager": "pnpm@11.13.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "msw:check": "tsc --ignoreConfig --module node16 --moduleResolution node16 --target es2022 --skipLibCheck --outDir .expo/msw-check api/mocks/native.ts api/mocks/server.ts api/mocks/on-unhandled-request.ts && node scripts/check-msw.cjs",
    "ui:check": "node scripts/check-ui.cjs",
    "ui:add": "pnpm dlx shadcn@latest add --yes",
    "tokens:sync": "node scripts/sync-pen-tokens.cjs && node scripts/sync-tokens.cjs",
    "tokens:check": "node scripts/sync-pen-tokens.cjs --check && node scripts/sync-tokens.cjs --check && node scripts/check-tokens.cjs",
    "harness:sync": "node scripts/sync-harness.cjs",
    "harness:check": "node scripts/check-harness.cjs",
    "harness:backup": "node scripts/harness-backup.cjs",
    "harness:restore": "node scripts/harness-restore.cjs",
    "e2e": "maestro test .maestro/flows"
  },
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.62.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "fast-text-encoding": "^1.0.6",
    "msw": "2.3.5",
    "react-native-url-polyfill": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
