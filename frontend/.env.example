# 호스트만 지정합니다. API 요청 경로에는 /api/v1을 붙입니다.
# 배포 환경에서는 실제 백엔드 HTTPS 호스트로 교체합니다.
EXPO_PUBLIC_API_URL=https://api.yeogirok.test

# WebView 지도: 카카오 JavaScript 키, 웹 플랫폼에 http://localhost 등록
EXPO_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# 배포 소셜 로그인: 제공자 콘솔에서 발급한 공개 앱 설정값
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# ARCore: Keyless 인증 사용. Google Cloud에 패키지명과 서명 SHA-1의 Android OAuth 클라이언트를 등록합니다.
# ARCORE_API_KEY는 사용하지 않습니다. 새 Cloud Anchor는 365일 TTL로 요청합니다.
